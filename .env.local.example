# Copy to .env.local and fill in. .env.local is gitignored.
#
# Precedence, highest first:
#   process.env  ->  .env.local  ->  .env.development / .env.production  ->  .env
#
# Two kinds of variable, and the difference matters:
#
#   NEXT_PUBLIC_*   inlined into the browser bundle at build time. Readable by anyone
#                   who loads the page. Never put a secret here.
#   everything else server-only: route handlers, server components, server actions.
#                   Reading one of these from client code yields undefined.
#
# This file is gitignored. Do not commit it, and do not paste it into an issue.

# ── Public: safe in the browser ───────────────────────────────────────────────
# The gateway the browser talks to directly for chat, keys and deposits.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080/v1
# Shown on the payment screen and used to prompt a wallet to switch networks.
NEXT_PUBLIC_ARC_CHAIN_ID=5042
NEXT_PUBLIC_ARC_EXPLORER=https://explorer.arc.io

# ── Upstream completions (server-only) ───────────────────────────────────────
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Added to upstream prices to produce the catalog price.
PRICE_MARKUP=0.05

# ── Auth.js / NextAuth (server-only) ─────────────────────────────────────────
# NEXTAUTH_URL is the app's own origin, not the gateway's. Auth.js derives the
# callback from it as ${NEXTAUTH_URL}/api/auth/callback/google — register THAT in the
# Google console, not the Python gateway's /v1/auth/oauth/... path.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Arc deposits (server-only) ───────────────────────────────────────────────
# Off unless 1: chain 5042 is a live network and these addresses take real USDC.
ARC_ENABLE=0
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_USDC_DECIMALS=6
ARC_CONFIRMATIONS=2
# Every deposit address is derived from this. Whoever holds it controls them all.
ARC_MASTER_SEED=

# ── Development only ─────────────────────────────────────────────────────────
# Grants account balance for nothing. Never enable this in production.
DEV_CREDIT=0
