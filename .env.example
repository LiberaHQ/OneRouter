# Copy to .env and fill in. .env is gitignored and never served or built into the site.
# Real environment variables take precedence over this file.

# ── Upstream completions ───────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint. With these unset the gateway answers from a local
# engine that is clearly labelled as not being a language model.
ONEROUTER_UPSTREAM_URL=https://openrouter.ai/api/v1
ONEROUTER_UPSTREAM_KEY=
# ONEROUTER_UPSTREAM_MODEL=          # force one model; default passes the id through
ONEROUTER_MARKUP=0.05                # added to upstream prices by tools/sync_catalog.py

# ── Sign-in ───────────────────────────────────────────────────────────────────
ONEROUTER_RP_ID=localhost            # WebAuthn relying party
ONEROUTER_ORIGINS=http://localhost:4321
ONEROUTER_GOOGLE_CLIENT_ID=
ONEROUTER_GOOGLE_CLIENT_SECRET=
ONEROUTER_GITHUB_CLIENT_ID=
ONEROUTER_GITHUB_CLIENT_SECRET=
# Must match the provider's registration byte for byte. The gateway prints the URI it
# sends at startup, and serves /v1/auth/oauth/<p>/callback plus two aliases:
#   /api/auth/<provider>/callback  and  /api/auth/callback/<provider>
ONEROUTER_OAUTH_REDIRECT_BASE=http://localhost:8080
ONEROUTER_OAUTH_CALLBACK_PATH=/v1/auth/oauth/{provider}/callback
# ONEROUTER_SMTP_HOST=               # unset means the email code is printed, not sent

# ── Arc deposits (USDC) ───────────────────────────────────────────────────────
# Off until explicitly enabled: chain 5042 is a live network and these addresses
# receive real money.
ONEROUTER_ARC_ENABLE=0
ONEROUTER_ARC_RPC=https://rpc.mainnet.arc.io
ONEROUTER_ARC_CHAIN_ID=5042
ONEROUTER_ARC_USDC=0x3600000000000000000000000000000000000000
ONEROUTER_ARC_DECIMALS=6
ONEROUTER_ARC_CONFIRMATIONS=2
ONEROUTER_ARC_EXPLORER=https://explorer.arc.io
# Every deposit address is derived from this seed. Whoever holds it controls them all.
# Unset means one is generated into gateway/state.json — development only.
ONEROUTER_ARC_MASTER_SEED=

# ── Development only ──────────────────────────────────────────────────────────
# Grants account balance for nothing. Off by default once an upstream is configured.
ONEROUTER_DEV_CREDIT=0
